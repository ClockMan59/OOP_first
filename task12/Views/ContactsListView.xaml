<UserControl x:Class="task12.Views.ContactsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <Button Content="Добавить новый" Command="{Binding AddCommand}" Margin="0,0,0,10" Padding="5"/>
        <Button Content="Редактировать" Command="{Binding EditCommand}" Margin="0,0,0,10" Padding="5"/>
        <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="0,0,0,10" Padding="5"/>

        <DataGrid ItemsSource="{Binding Contacts}"
                  SelectedItem="{Binding SelectedContact}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto" />
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
